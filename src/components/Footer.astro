---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-info">
      <span class="brand-text">WAY TO <span class="accent">DOOMSDAY</span></span>
      <p class="tagline">
        Every MCU movie and series, in order, before Avengers: Doomsday hits theaters.
        An unofficial fan project — not affiliated with Marvel Studios or Disney.
      </p>
      <p class="copyright">&copy; {year} Way to Doomsday. All rights reserved.</p>
      <section class="tmdb-credits" aria-label="Data and image credits">
        <h2>Credits</h2>
        <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer">
          <img
            src="https://www.themoviedb.org/assets/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
            alt="TMDB" width="80" height="11" loading="lazy" referrerpolicy="no-referrer"
          />
        </a>
        <p>Official cast information: Marvel / Disney. Actor portrait data and images, when available: TMDB.</p>
        <p>This website uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.</p>
      </section>
    </div>

    <div class="footer-contact">
      <span class="contact-heading">Contact</span>

  

      <a href="mailto:waytodoomsday@gmail.com" class="contact-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>waytodoomsday@gmail.com</span>
      </a>

      <a href="/privacy-policy" class="contact-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <path d="M14 2v6h6"></path>
          <path d="M16 13H8"></path>
          <path d="M16 17H8"></path>
          <path d="M10 9H8"></path>
        </svg>
        <span>Privacy Policy</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .tmdb-credits { margin-top: 1.25rem; font-size: .8125rem; line-height: 1.6; color: #a9a9a9; }
  .tmdb-credits h2 { font-size: .875rem; color: #e9e9e9; margin-bottom: .5rem; }
  .tmdb-credits a { display: inline-flex; min-height: 44px; align-items: center; }
  .tmdb-credits img { width: 80px; height: auto; }
  .tmdb-credits p + p { margin-top: .375rem; }
  .site-footer {
    width: 100%;
    background: #0a0a0a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3rem 1.5rem;
    margin-top: 3rem;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .footer-info {
    max-width: 480px;
    text-align: left;
  }

  .brand-text {
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: 1rem;
    color: #ffffff;
    text-transform: uppercase;
  }

  .accent {
    color: #22c55e;
  }

  .tagline {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }

  .copyright {
    margin-top: 1.25rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    text-align: left;
  }

  .contact-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.25rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .contact-link svg {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #22c55e;
  }

  .contact-link:hover svg {
    color: #22c55e;
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: left;
    }
  }
</style>
